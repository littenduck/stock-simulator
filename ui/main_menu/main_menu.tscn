[gd_scene load_steps=4 format=3]

[ext_resource type="PackedScene" path="res://ui/theme/animated_background.tscn" id="bg"]
[ext_resource type="Script" path="res://ui/main_menu/main_menu.gd" id="1"]
[ext_resource type="PackedScene" path="res://ui/audio/music_player.tscn" id="music"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture_filter = 1
script = ExtResource("1")

[node name="Background" parent="." instance=ExtResource("bg")]

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
